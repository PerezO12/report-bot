{
  "flow_id": "incidencia",
  "command": "/incidencia",
  "title": "Reporte de Incidencia o Solicitud",
  "steps": [
    {
      "id": "step_type",
      "question": "❓ ¿Es una incidencia o una solicitud?",
      "validation": {
        "type": "options",
        "choices": ["Incidencia", "Solicitud"]
      },
      "optional": false,
      "keyboard": {
        "enabled": true,
        "layout": "column",
        "buttons": [
          {"label": "🚨 Incidencia", "value": "incidencia"},
          {"label": "📝 Solicitud", "value": "solicitud"}
        ]
      },
      "next_step": {
        "type": "conditional",
        "on": "step_type",
        "cases": {
          "incidencia": "step_region",
          "solicitud": "step_business_request"
        },
        "default": null
      }
    },
    {
      "id": "step_region",
      "question": "🌍 ¿Cuál es la región?",
      "validation": {
        "type": "options",
        "choices": ["Región 0", "Región 1", "Región 2", "Región 3", "Región 4"]
      },
      "optional": false,
      "keyboard": {
        "enabled": true,
        "layout": "column",
        "buttons": [
          {"label": "Región 0", "value": "region_0"},
          {"label": "Región 1", "value": "region_1"},
          {"label": "Región 2", "value": "region_2"},
          {"label": "Región 3", "value": "region_3"},
          {"label": "Región 4", "value": "region_4"}
        ]
      },
      "next_step": "step_business_incident"
    },
    {
      "id": "step_business_incident",
      "question": "🏪 ¿Cuál es el nombre del negocio?\n*Ej:* Supermercado El Sol",
      "validation": {
        "type": "text"
      },
      "optional": false,
      "keyboard": null,
      "next_step": "step_system"
    },
    {
      "id": "step_system",
      "question": "🔧 ¿Cuál es el sistema, entorno y versión?\n*Ej:* Admin Beta, APK PV Legacy, Admin Legacy",
      "validation": {
        "type": "text"
      },
      "optional": false,
      "keyboard": null,
      "next_step": "step_description"
    },
    {
      "id": "step_description",
      "question": "📝 Descripción detallada del problema.\nIncluye paso a paso, trazas y datos reales.\n*Ej:* Producto 'Pollo' en Factura No. 35 del ciclo del 7/4/26 no aparece en el reporte.",
      "validation": {
        "type": "text"
      },
      "optional": false,
      "keyboard": null,
      "next_step": "step_confirmed"
    },
    {
      "id": "step_confirmed",
      "question": "✅ ¿Fue revisado y confirmado por el comercial que reporta?",
      "validation": {
        "type": "boolean",
        "choices": ["Sí", "No"]
      },
      "optional": false,
      "keyboard": {
        "enabled": true,
        "layout": "row",
        "buttons": [
          {"label": "✅ Sí", "value": "yes"},
          {"label": "❌ No", "value": "no"}
        ]
      },
      "next_step": "step_evidence"
    },
    {
      "id": "step_evidence",
      "question": "📎 Envía fotos y/o vídeos como evidencia del problema.\n_Este paso es obligatorio._",
      "validation": {
        "type": "media"
      },
      "optional": false,
      "keyboard": null,
      "next_step": null
    },
    {
      "id": "step_business_request",
      "question": "🏪 ¿Cuál es el nombre del negocio?\n*Ej:* Supermercado El Sol",
      "validation": {
        "type": "text"
      },
      "optional": false,
      "keyboard": null,
      "next_step": "step_apk"
    },
    {
      "id": "step_apk",
      "question": "📱 ¿Cuál es la aplicación o módulo?",
      "validation": {
        "type": "options",
        "choices": ["Administración", "APK Gestión", "APK Punto de Venta"]
      },
      "optional": false,
      "keyboard": {
        "enabled": true,
        "layout": "column",
        "buttons": [
          {"label": "💼 Administración", "value": "administracion"},
          {"label": "📊 APK Gestión", "value": "apk_gestion"},
          {"label": "🛒 APK Punto de Venta", "value": "apk_pv"}
        ]
      },
      "next_step": "step_implementation"
    },
    {
      "id": "step_implementation",
      "question": "💡 ¿Qué se quiere implementar o mejorar?\n*Ej:* Agregar opción para exportar reportes en PDF",
      "validation": {
        "type": "text"
      },
      "optional": false,
      "keyboard": null,
      "next_step": "step_usage_example"
    },
    {
      "id": "step_usage_example",
      "question": "📚 ¿Cómo se usaría? Describe el flujo o ejemplo de uso.\n*Ej:* Usuario entra a reportes, hace clic en 'Exportar PDF', recibe archivo",
      "validation": {
        "type": "text"
      },
      "optional": false,
      "keyboard": null,
      "next_step": null
    }
  ],
  "summary_template": "incidencia"
}
