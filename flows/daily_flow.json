{
  "flow_id": "daily",
  "command": "/daily",
  "title": "Hacer Daily",
  "steps": [
    {
      "id": "step_date",
      "question": "📅 ¿Para qué fecha es este daily?",
      "validation": {
        "type": "date_selector"
      },
      "optional": false,
      "keyboard": null,
      "next_step": "step_yesterday_hours"
    },
    {
      "id": "step_yesterday_hours",
      "question": "🕐 ¿Cuántas horas trabajaste ayer?\n*Ej:* 7.5 ó 8",
      "validation": {
        "type": "number",
        "min": 0,
        "max": 24
      },
      "optional": false,
      "keyboard": null,
      "next_step": "step_yesterday_desc"
    },
    {
      "id": "step_yesterday_desc",
      "question": "📝 Describe en qué trabajaste ayer.\n*Ej:* Implementé el módulo de autenticación y corregí 3 bugs del sprint.",
      "validation": {
        "type": "text"
      },
      "optional": false,
      "keyboard": null,
      "next_step": "step_today"
    },
    {
      "id": "step_today",
      "question": "📋 ¿En qué planeas trabajar hoy?\n*Ej:* Revisión de PRs pendientes y reunión con QA.",
      "validation": {
        "type": "text"
      },
      "optional": false,
      "keyboard": null,
      "next_step": "step_blocker"
    },
    {
      "id": "step_blocker",
      "question": "🚧 ¿Tienes algún bloqueo?",
      "validation": {
        "type": "boolean",
        "choices": ["Sí", "No"]
      },
      "optional": false,
      "keyboard": {
        "enabled": true,
        "layout": "row",
        "buttons": [
          {"label": "✅ Sí", "value": "yes"},
          {"label": "❌ No", "value": "no"}
        ]
      },
      "next_step": {
        "type": "conditional",
        "on": "step_blocker",
        "cases": {
          "yes": "step_blocker_desc",
          "no": null
        },
        "default": null
      }
    },
    {
      "id": "step_blocker_desc",
      "question": "📌 Describe el bloqueo.\n*Ej:* No tengo acceso al ambiente de staging.",
      "validation": {
        "type": "text"
      },
      "optional": false,
      "keyboard": null,
      "next_step": "step_needs_meeting"
    },
    {
      "id": "step_needs_meeting",
      "question": "🤝 ¿Necesitas una reunión para resolverlo?",
      "validation": {
        "type": "boolean",
        "choices": ["Sí", "No"]
      },
      "optional": false,
      "keyboard": {
        "enabled": true,
        "layout": "row",
        "buttons": [
          {"label": "✅ Sí", "value": "yes"},
          {"label": "❌ No", "value": "no"}
        ]
      },
      "next_step": {
        "type": "conditional",
        "on": "step_needs_meeting",
        "cases": {
          "yes": "step_meeting_time",
          "no": null
        },
        "default": null
      }
    },
    {
      "id": "step_meeting_time",
      "question": "📅 ¿Cuándo y a qué hora propones la reunión?\n*Ej:* Mañana a las 10:00 AM",
      "validation": {
        "type": "text"
      },
      "optional": false,
      "keyboard": null,
      "next_step": null
    }
  ],
  "summary_template": "daily"
}
