# Token del bot — obtenido desde @BotFather en Telegram
BOT_TOKEN=your_telegram_bot_token_here

# Chat ID del administrador que recibirá los reportes
# Para obtenerlo: habla con @userinfobot en Telegram
ADMIN_CHAT_ID=your_admin_chat_id_here

# Proxy (necesario en PythonAnywhere plan gratuito y entornos similares)
# Pon USE_PROXY=true cuando corras en PythonAnywhere; false para desarrollo local
USE_PROXY=false
PROXY_URL=http://proxy.server:3128
