# Bot de Reportes (BotDaily)
BOT_TOKEN=your_telegram_bot_token_here

# Grupo de Incidencias y Solicitudes (recibe reportes de problemas y mejoras)
INCIDENCIAS_GROUP_ID=your_incidencias_group_id_here

# Grupo de Dailies (recibe reportes diarios de standups)
DAILIES_GROUP_ID=your_dailies_group_id_here

# Bot de Administración (BotAdmin)
ADMIN_BOT_TOKEN=your_admin_bot_token_here

# User IDs autorizados para usar el admin bot (separados por coma)
# Ejemplo: 123456789,987654321,111222333
ADMIN_USER_IDS=your_admin_user_id_here

# Proxy (necesario en PythonAnywhere plan gratuito y entornos similares)
USE_PROXY=false
PROXY_URL=http://proxy.server:3128
